/target
/target-*/

# 配布元は submodule で固定する（利用者の global ignore より優先）。
!/vendor/
!/vendor/aidlc-workflows

# 廃止した fork 同期（scripts/aidlc-sync.ts）が作業ツリーに残した退避・排他ロック。
/.aidlc-sync/

# 利用者ごとの mise ローカル設定（アカウント設定のパスなど個人の環境変数を含む）。
mise.local.toml

# AI-DLC はこのリポジトリからアンインストールした（2026-10-05）。手元で aidlc を動かすと
# ワークスペース（aidlc/）や迷子のランタイム領域ができるが、どれも派生物なのでコミットしない。
# 以前のインストールが残した手元のファイル（監査シャード・ランタイムの sqlite など）もここで隠れる。
/aidlc/
scripts/aidlc/
scripts/tests/aidlc/
.claude/settings.local.json
